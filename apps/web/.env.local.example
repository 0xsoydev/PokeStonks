# PokeStonks web app. Copy to .env.local and fill in. No secrets belong in NEXT_PUBLIC_* variables.

# ---- Client (browser) -----------------------------------------------------------------------
# Privy app id for "Sign in with Google" + embedded wallet. Leave empty for guest-only mode
# (everything still works with a throwaway wallet). In the Privy dashboard: enable Google login,
# add http://localhost:3000 and your deployed origin to Allowed origins.
NEXT_PUBLIC_PRIVY_APP_ID=

# Monad testnet (chain id 10143). Override only if you run your own RPC.
NEXT_PUBLIC_RPC_URL=https://testnet-rpc.monad.xyz

# Battle server (Colyseus), used by the game overlay. ws:// for local, wss:// when deployed.
NEXT_PUBLIC_COLYSEUS_URL=ws://localhost:2567

# Optional overrides. By default addresses come from packages/contracts-abi/deployments.json.
# NEXT_PUBLIC_ARENA_ADDRESS=
# NEXT_PUBLIC_BROKERMON_ADDRESS=

# ---- Server only (Route Handlers; never exposed to the browser) ------------------------------
# Pyth Hermes price routes require an API key since 2026-08-26 (Authorization: Bearer <key>).
# Without it /api/spawns still works: prices fall back to static values and markets show as not live.
# PYTH_API_KEY=
# HERMES_URL=https://hermes.pyth.network

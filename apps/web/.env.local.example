# PokeStonks — Web3 env vars
# Copy to .env.local, fill in values

# Colyseus realtime server
NEXT_PUBLIC_COLYSEUS_URL=wss://<colyseus-host>

# Privy (Google login + embedded wallet)
NEXT_PUBLIC_PRIVY_APP_ID=

# Monad testnet
NEXT_PUBLIC_CHAIN_ID=10143
NEXT_PUBLIC_RPC_URL=https://testnet-rpc.monad.xyz

# Contract addresses (deployed in Phase 4)
NEXT_PUBLIC_ARENA_ADDRESS=0x
NEXT_PUBLIC_VAULT_ADDRESS=0x
NEXT_PUBLIC_SSTOCK_ADDRESS=0x
NEXT_PUBLIC_BROKERMON_ADDRESS=0x

# Pyth
NEXT_PUBLIC_PYTH_ADDRESS=0x2880aB155794e7179c9eE2e38200202908C17B43
NEXT_PUBLIC_TSLA_FEED=0x16dad506d7db8da01c87581c87ca897a012a153557d4d578c3b9c9e1bc0632f1
